# Copy this file to .env and fill in DATABASE_URL with your Neon connection
# string (from the Neon console: Project -> Connect -> copy the "psql" or
# "connection string" value, which looks like:
#   postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Any standard Postgres works too (local, RDS, on-site, etc.) — Neon isn't required.

DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/scaleiot?sslmode=require
PORT=4000

# ---------- Multi-site sync (optional) ----------
# Leave SYNC_ROLE unset (or "none") for a standalone instance, or a "cloud"
# instance that only receives pushes from sites — POST /api/sync/push is
# always available regardless of this setting; it's how sites push in.
#
# Set SYNC_ROLE=local on an on-site instance to make it actively push its
# own data up to a cloud instance. See README's "Multi-site sync" section
# for the full setup (create a sync key on the cloud instance first, from
# its dashboard's "Sync" panel, admin role required).

SYNC_ROLE=none
# CLOUD_SYNC_URL=https://your-cloud-backend.example.com
# CLOUD_SYNC_KEY=paste-the-site-key-from-the-cloud-instance-here
# SYNC_INTERVAL_MS=15000
# SYNC_BATCH_SIZE=500

# ---------- Data retention (optional) ----------
# Set to a number of days to automatically purge readings older than that.
# 0 or unset = keep everything forever (fine for a pilot, but add this
# before running unattended for months).
# READING_RETENTION_DAYS=90
