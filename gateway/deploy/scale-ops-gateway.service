[Unit]
Description=Scale Ops edge gateway
Documentation=https://github.com/your-org/scale-ops
# Only requires network — the gateway itself waits out a dead backend rather
# than needing it to already be reachable at boot.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change these three paths/user to match the target machine. WorkingDirectory
# must be the gateway/ folder (relative paths — .env, drivers/, queue file —
# all resolve from here).
User=scaleops
WorkingDirectory=/opt/scale-ops/gateway
ExecStart=/usr/bin/node gateway.js
EnvironmentFile=/opt/scale-ops/gateway/.env

Restart=always
RestartSec=5
# A crash loop (bad config, etc.) shouldn't hammer the backend or spam logs
# forever — back off after repeated failures instead of retrying every 5s indefinitely.
StartLimitIntervalSec=300
StartLimitBurst=10

# Standard hardening for a service running unattended on a plant network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/scale-ops/gateway

StandardOutput=journal
StandardError=journal
SyslogIdentifier=scale-ops-gateway

[Install]
WantedBy=multi-user.target
