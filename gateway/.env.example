# Copy this file to .env and fill in the values.
# The backend prints a default GATEWAY_API_KEY to its console on first run —
# or generate/revoke keys any time from the dashboard's Gateway Keys panel.

BACKEND_URL=http://localhost:4000
GATEWAY_API_KEY=paste-the-key-here
POLL_INTERVAL_MS=500

# How many readings to buffer locally during a backend/internet outage before
# the oldest ones start getting dropped. Default (500,000) covers roughly:
#   1 device   -> ~2.9 days
#   4 devices  -> ~17 hours
#   10 devices -> ~7 hours
#   20 devices -> ~3.5 hours
# (at the default 500ms poll interval — halve/double these if you change
# POLL_INTERVAL_MS). Each entry is roughly 50-100 bytes, so even a much
# larger cap costs very little disk. Raise this if your site's internet is
# unreliable enough that hours isn't enough — see EDGE_DEPLOYMENT.md.
MAX_QUEUED_READINGS=500000

# Optional. See EDGE_DEPLOYMENT.md if using Docker/systemd with a persistent
# volume for the buffer file.
# QUEUE_DIR=/app/data

# Local-only diagnostic endpoint (GET /healthz). Never expose this to the
# internet — see EDGE_DEPLOYMENT.md.
HEALTH_PORT=9090
